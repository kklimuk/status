{
	"name": "status",
	"type": "module",
	"private": true,
	"bin": {
		"status": "./src/index.ts"
	},
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"check": "bun run typecheck && bun run lint && bun run knip && bun test",
		"typecheck": "bun check",
		"lint": "biome check --error-on-warnings",
		"format": "biome check --write",
		"knip": "knip",
		"db:generate": "drizzle-kit generate"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.11",
		"knip": "^6.42.1"
	},
	"peerDependencies": {
		"typescript": "^7"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4"
	}
}

#!/bin/sh
# fact: git passes <previous HEAD> <new HEAD> <branch flag>, and the previous HEAD is all zeros on a fresh checkout.
case "$1" in
*[!0]*) exit 0 ;;
esac

git_dir=$(git rev-parse --absolute-git-dir)
common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
[ "$git_dir" = "$common_dir" ] && exit 0

worktree=$(git rev-parse --show-toplevel)
cd "$worktree" || exit 1

if ! bun install --frozen-lockfile; then
	echo "status: bun install failed in $worktree" >&2
	exit 1
fi

if [ ! -f src/app.ts ]; then
	echo "status: worktree ready at $worktree"
	exit 0
fi

if ! database=$(bun -e 'const { createApp } = await import("./src/app"); const app = createApp(process.env); app.database.$client.close(); process.stdout.write(app.database.$client.filename);'); then
	echo "status: could not create the worktree's database in $worktree" >&2
	exit 1
fi

echo "status: worktree ready at $worktree (database: $database)"
